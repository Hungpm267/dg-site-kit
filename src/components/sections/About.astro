---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

type About = NonNullable<CollectionEntry<'clients'>['data']['about']>;

interface Props {
  about: About;
  headingLevel?: 'h1' | 'h2';
}

const { about, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

{/*
  Phần giới thiệu đặt kiểu bài đọc: câu dẫn cỡ lớn, thân bài một cột hẹp.
  Không chia hai cột chữ — đây là chỗ duy nhất trên site người ta đọc từ đầu
  đến cuối chứ không quét, nên độ dài dòng mới là thứ cần tối ưu.
*/}
<section id="ve-chung-toi" class="scroll-mt-20 bg-paper py-20 sm:py-28">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <p class="eyebrow text-brand-600">Về chúng tôi</p>
    <Heading
      class="mt-5 max-w-3xl font-display text-4xl leading-tight font-bold text-brand-900 sm:text-5xl"
    >
      {about.heading}
    </Heading>

    <p class="mt-8 max-w-3xl font-display text-xl leading-relaxed text-brand-700 sm:text-2xl" data-reveal>
      {about.lead}
    </p>

    <div class="mt-14 grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="max-w-prose space-y-6 lg:col-span-7">
        {
          about.paragraphs.map((p, i) => (
            <p class="text-base leading-[1.8] text-ink-700" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              {p}
            </p>
          ))
        }
      </div>

      <div class="lg:col-span-5">
        {
          about.image && (
            <div class="lift lift-zoom" data-reveal>
              <Image
                src={about.image}
                alt={about.imageAlt ?? ''}
                widths={[400, 800]}
                sizes="(min-width: 1024px) 24rem, 100vw"
                loading="lazy"
                class="aspect-4/3 w-full rounded-sm object-cover"
              />
            </div>
          )
        }

        {
          about.highlights && about.highlights.length > 0 && (
            <dl class="mt-8 border-t border-paper-line">
              {about.highlights.map((h, i) => (
                <div
                  class="flex items-baseline justify-between gap-4 border-b border-paper-line py-4"
                  data-reveal
                  style={`--reveal-delay:${i * 80}ms`}
                >
                  <dt class="text-sm leading-relaxed text-ink-500">{h.label}</dt>
                  <dd class="font-display text-lg font-bold text-brand-900">{h.value}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
    </div>
  </div>
</section>
